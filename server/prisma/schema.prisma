generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MERCHANT (Multi-Tenant Core)
// ============================================
model merchants {
  id                Int       @id @default(autoincrement())
  clerk_user_id     String    @unique @db.VarChar(255)
  business_name     String?   @db.VarChar(200)
  email             String?   @db.VarChar(255)
  shopify_shop_name String?   @db.VarChar(200)
  shopify_access_token String? @db.Text
  shopify_api_key   String?   @db.VarChar(200)
  shopify_api_secret String?  @db.Text
  webhook_id        String?   @db.VarChar(100)
  plan              String?   @default("free") @db.VarChar(50)
  is_active         Boolean   @default(true)
  email_subject     String?   @db.VarChar(255)
  email_body        String?   @db.Text
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @updatedAt @db.Timestamp(6)

  // Relations
  products      products[]
  orders        orders[]
  users         users[]
  upsell_events upsell_events[]
  upsell_rules  upsell_rules[]
  abandoned_carts abandoned_carts[]
}

// ============================================
// EXISTING TABLES (with merchant_id added)
// ============================================
model order_items {
  id         Int       @id @default(autoincrement())
  order_id   Int?
  product_id Int?
  quantity   Int?      @default(1)
  orders     orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products   products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  id            Int             @id @default(autoincrement())
  merchant_id   Int?
  shopify_id    BigInt?         @unique
  user_id       Int?
  total_amount  Decimal?        @db.Decimal(10, 2)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  order_items   order_items[]
  merchants     merchants?      @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  upsell_events upsell_events[]

  @@index([merchant_id])
  @@index([user_id])
}

model products {
  id                                                     Int             @id @default(autoincrement())
  merchant_id                                            Int?
  shopify_id                                             BigInt?         @unique
  shopify_variant_id                                     BigInt?
  name                                                   String?         @db.VarChar(150)
  handle                                                 String?         @db.VarChar(255)
  description                                            String?         @db.Text
  category                                               String?         @db.VarChar(100)
  price                                                  Decimal?        @db.Decimal(10, 2)
  image_url                                              String?         @db.Text
  created_at                                             DateTime?       @default(now()) @db.Timestamp(6)
  merchants                                              merchants?      @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_items                                            order_items[]
  upsell_events                                          upsell_events[]
  upsell_rules_upsell_rules_trigger_product_idToproducts upsell_rules[]  @relation("upsell_rules_trigger_product_idToproducts")
  upsell_rules_upsell_rules_upsell_product_idToproducts  upsell_rules[]  @relation("upsell_rules_upsell_product_idToproducts")

  @@index([merchant_id])
}

model upsell_events {
  id                Int       @id @default(autoincrement())
  merchant_id       Int?
  user_id           Int?
  order_id          Int?      @unique
  upsell_product_id Int?
  discount_percent  Int?
  pitch             String?   @db.Text
  shown_at          DateTime? @default(now()) @db.Timestamp(6)
  expires_at        DateTime? @db.Timestamp(6)
  converted         Boolean?  @default(false)
  test_group        String?   @db.VarChar(10) // 'A' (AI/Personalized) vs 'B' (Control/Generic)
  impression_count  Int       @default(0)     // Real widget display count (incremented by /shown endpoint)
  event_type        String    @default("post_purchase") @db.VarChar(20) // "post_purchase" | "abandoned_cart"
  abandoned_cart_id Int?      // Links to abandoned_carts table (null for post_purchase)
  merchants         merchants? @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders            orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products          products? @relation(fields: [upsell_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  abandoned_cart   abandoned_carts? @relation(fields: [abandoned_cart_id], references: [id])

  @@index([merchant_id])
  @@index([user_id])
  @@index([order_id])
  @@index([event_type])
}

model upsell_rules {
  id                                                 Int       @id @default(autoincrement())
  merchant_id                                        Int?
  trigger_product_id                                 Int?
  upsell_product_id                                  Int?
  discount_percent                                   Int?
  active                                             Boolean?  @default(true)
  merchants                                          merchants? @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products_upsell_rules_trigger_product_idToproducts products? @relation("upsell_rules_trigger_product_idToproducts", fields: [trigger_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products_upsell_rules_upsell_product_idToproducts  products? @relation("upsell_rules_upsell_product_idToproducts", fields: [upsell_product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id            Int             @id @default(autoincrement())
  merchant_id   Int?
  email         String?         @unique @db.VarChar(255)
  name          String?         @db.VarChar(100)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  merchants     merchants?      @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders[]
  upsell_events upsell_events[]

  @@index([merchant_id])
}

// ============================================
// ABANDONED CART TRACKING
// ============================================
model abandoned_carts {
  id              Int       @id @default(autoincrement())
  merchant_id     Int?
  cart_token      String    @unique @db.VarChar(255)
  customer_email  String?   @db.VarChar(255)
  customer_name   String?   @db.VarChar(200)
  cart_items      Json                                  // [{product_id, title, quantity, price, image}]
  cart_total      Decimal?  @db.Decimal(10, 2)
  status          String    @default("pending") @db.VarChar(20) // pending | recovered | expired | converted
  recovery_sent   Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @updatedAt @db.Timestamp(6)
  merchants       merchants? @relation(fields: [merchant_id], references: [id])
  upsell_events   upsell_events[]

  @@index([merchant_id])
  @@index([customer_email])
  @@index([status])
}

